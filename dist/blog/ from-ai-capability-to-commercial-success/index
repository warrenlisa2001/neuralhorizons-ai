  <script>
    (function () {
      const progress = document.getElementById('progressBar');
      const backTop = document.getElementById('backTop');
      const tocLinks = Array.from(document.querySelectorAll('.toc a'));
      const sections = tocLinks.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
      function updateScroll() {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const percent = max > 0 ? (doc.scrollTop / max) * 100 : 0;
        progress.style.width = percent + '%';
        backTop.style.display = doc.scrollTop > 500 ? 'block' : 'none';
        let current = sections[0];
        sections.forEach(section => { if (section.getBoundingClientRect().top < 150) current = section; });
        tocLinks.forEach(link => link.classList.toggle('active', current && link.getAttribute('href') === '#' + current.id));
      }
      window.addEventListener('scroll', updateScroll, { passive: true });
      updateScroll();
      backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      const stageCopy = {
        pad: '<strong>PAD:</strong> Establish whether the opportunity is real, whether the organisation can act on it and whether the required data is ready.',
        pod: '<strong>Innovation POD:</strong> Bring the right business, technology, operational and commercial people together to challenge assumptions, prioritise use cases and assign ownership.',
        poc: '<strong>POC:</strong> Test technical feasibility, key assumptions and whether the proposed solution can address the problem. Define success criteria before the test begins.',
        por: '<strong>POR:</strong> Pilot in a real environment, measure outcomes, optimise the workflow and make an evidence-based decision about wider rollout.'
      };
      document.querySelectorAll('.stage').forEach(button => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.stage').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
          document.getElementById('stageDetail').innerHTML = stageCopy[button.dataset.stage];
        });
      });

      document.getElementById('scoreButton').addEventListener('click', () => {
        const checks = Array.from(document.querySelectorAll('.readiness-check'));
        const count = checks.filter(check => check.checked).length;
        const result = document.getElementById('quizResult');
        let heading, message;
        if (count <= 2) {
          heading = 'Start with the foundations.';
          message = 'Your next step is to clarify the business problem, readiness and customer need before committing to a full build or launch.';
        } else if (count <= 5) {
          heading = 'You have a foundation, but there are gaps to close.';
          message = 'Prioritise the missing pieces across positioning, validation, GTM and measurement. Make sure the commercial plan develops alongside the product.';
        } else {
          heading = 'You are building a connected route to market.';
          message = 'Keep testing the assumptions with customers and make sure operational evidence, governance and commercial reporting remain connected as you scale.';
        }
        result.innerHTML = '<strong>' + count + ' of ' + checks.length + ' readiness indicators selected.</strong><br><b>' + heading + '</b> ' + message;
        result.style.display = 'block';
      });
    })();
  </script>
