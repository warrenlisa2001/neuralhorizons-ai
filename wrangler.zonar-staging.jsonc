{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zonar-staging",
  "compatibility_date": "2026-05-16",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Every API path must reach the Worker; otherwise the asset layer can answer
    // an unknown /api/ path with its own 404 page before ZONAR's code runs.
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ZONAR_DB",
      "database_name": "zonar-staging-db-20261116",
      "database_id": "92316a0a-489d-47d5-adf4-c323a192c3b9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ZONAR_FILES",
      "bucket_name": "zonar-staging-files"
    }
  ],
  "vars": {
    "ZONAR_ISSUER": "https://login.microsoftonline.com/c6993c9c-10dd-4cfe-ba91-157272624bd6/v2.0",
    "ZONAR_AUDIENCE": "68673793-9332-440b-ab12-d181b1128a17",
    "ZONAR_JWKS_URL": "https://login.microsoftonline.com/c6993c9c-10dd-4cfe-ba91-157272624bd6/discovery/v2.0/keys",
    "ZONAR_REQUIRED_SCOPE": "access_as_user",
    // The async flag is on now that the D1 database exists and migrations 0001-0010 are applied
    // (docs/zonar-staging-provisioning-runbook.md). Resumable uploads stay off until tested.
    "ZONAR_ASYNC_ENABLED": "true",
    "ZONAR_RESUMABLE_UPLOADS_ENABLED": "false"
  },
  "queues": {
    "producers": [
      { "binding": "ZONAR_RECONCILIATION_QUEUE", "queue": "zonar-staging-reconciliation" }
    ],
    "consumers": [
      {
        "queue": "zonar-staging-reconciliation",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "zonar-staging-reconciliation-dlq"
      }
    ]
  },
  // Lease recovery, outbox dispatch and expired-upload cleanup. Inert while the
  // flags above are "false".
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true
  }
}
